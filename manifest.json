{
  "manifest_version": 3,
  "name": "LeetCode Solved Exporter",
  "version": "3.0",
  "description": "View all your solved LeetCode problems grouped by topic and move through them.",
  "permissions": ["storage"],
  "host_permissions": ["https://leetcode.com/*"],
  "action": { "default_title": "Open my solved dashboard" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js", "nav.js"]
    }
  ]
}